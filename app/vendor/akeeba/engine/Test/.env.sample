# --------------------------------------------------------------------------------------------------------------------
# Akeeba Engine — test suite environment configuration (SAMPLE)
# --------------------------------------------------------------------------------------------------------------------
#
# Copy this file to `Test/.env` and edit it to suit your machine. The real `Test/.env` file is git-ignored, so your
# local settings never get committed.
#
# `Test/bootstrap.php` reads this file automatically before running any test. Variables you already exported into your
# shell take precedence over the values defined here, so you can still override anything on a per-run basis, e.g.:
#
#     INTEGRATION_BACKUP=1 vendor/bin/phpunit Test/Integration/Backup/MisbehavingFileTest.php
#
# Syntax: one KEY=VALUE per line. Blank lines and lines starting with `#` are ignored. Surrounding quotes around the
# value are optional and stripped. A leading `export ` is allowed and ignored.
# --------------------------------------------------------------------------------------------------------------------


# =====================================================================================================================
# Database driver integration tests (Test/Integration/Driver/*)
# =====================================================================================================================
# The easiest way to run these is `./run-integration-tests.sh`, which spins up a throw-away server in Docker for each
# configured version, exports the connection variables below for you, runs the driver suite against it, and force-
# removes the container afterwards. It needs nothing but Docker.
#
#   ./run-integration-tests.sh                 # every image configured below
#   ./run-integration-tests.sh postgres:17     # one specific image
#   ./run-integration-tests.sh mariadb         # every image of one family
#
# --- Which server versions to spin up --------------------------------------------------------------------------------
# Space-separated image lists, one per database family. Quote the value: it contains spaces. Any tag on Docker Hub
# works, so this is where you add a new MySQL/MariaDB/PostgreSQL version to the matrix, or trim it down to a single
# server to keep a local run quick.
#INTEGRATION_MYSQL_IMAGES="mysql:8.0 mysql:8.4"
#INTEGRATION_MARIADB_IMAGES="mariadb:11.4 mariadb:12.3"
#INTEGRATION_POSTGRES_IMAGES="postgres:16 postgres:17"

# Host ports the containers are published on. Change them if these are already taken on your machine.
#INTEGRATION_DB_HOST_PORT=13306
#INTEGRATION_PGSQL_HOST_PORT=15432

# Credentials seeded into the throw-away containers.
#DB_PASSWORD=akeebatest
#DB_NAME=akeebatest

# --- Pointing the tests at a server you manage yourself ---------------------------------------------------------------
# Set these ONLY if you are not using run-integration-tests.sh. The MySQL/MariaDB drivers (MysqliTest, PdomysqlTest)
# self-skip unless INTEGRATION_DB_HOST is set; the PostgreSQL driver (PostgresqlTest) self-skips unless
# INTEGRATION_PGSQL_HOST is set. The two are independent, so you can run either family on its own.

#INTEGRATION_DB_HOST=127.0.0.1
#INTEGRATION_DB_PORT=3306
#INTEGRATION_DB_USER=root
#INTEGRATION_DB_PASSWORD=
#INTEGRATION_DB_NAME=akeebatest

#INTEGRATION_PGSQL_HOST=127.0.0.1
#INTEGRATION_PGSQL_PORT=5432
#INTEGRATION_PGSQL_USER=postgres
#INTEGRATION_PGSQL_PASSWORD=
#INTEGRATION_PGSQL_NAME=akeebatest


# =====================================================================================================================
# Misbehaving-file backup integration test (Test/Integration/Backup/MisbehavingFileTest)
# =====================================================================================================================
# This test backs up the dev_platform/ directory while dev_platform/makebigfile.php concurrently grows, shrinks, or
# deletes a 15 MiB file, verifying that the engine handles each case correctly. It drives the dev_platform CLI as a
# sub-process, so dev_platform must already be initialised (run `php dev_platform/index.php init` once).
#
# The whole test self-skips unless INTEGRATION_BACKUP is set to a truthy value (1, true, yes, on).

# Master switch. Set to 1 to enable the misbehaving-file backup test.
#INTEGRATION_BACKUP=1

# Per-chunk delay, in microseconds, the engine waits while writing a file into the archive. This deliberately slows the
# backup down so the engine is still reading the misbehaving file when makebigfile.php changes it. 100000 = 100 ms.
# This value is exported to the dev_platform CLI sub-process as AKEEBA_DEBUG_BIG_FILE_MULTIPART_DELAY.
#AKEEBA_DEBUG_BIG_FILE_MULTIPART_DELAY=100000

# Milliseconds makebigfile.php waits between each file-size change in `grow` and `shrink` mode. The size change spans
# roughly 80 steps, so the default of 120 ms makes the whole change take ~10 s. Increase it on slow machines if the
# engine finishes reading the file before makebigfile.php has had a chance to change it.
#BACKUP_MISBEHAVE_DELAY=120

# Milliseconds makebigfile.php waits in `nuke` mode before deleting the file. Tune this so the file disappears WHILE the
# engine is reading it (trial and error — it depends on how fast your machine runs the backup).
#BACKUP_NUKE_DELAY=5000

# Path to Akeeba Kickstart, used to verify that the partial archive produced by the `grow` scenario can be extracted
# (Kickstart's CLI dry-run mode is enough). This may be the kickstart.php / kickstart_core.php file itself, or a
# directory containing one of them. If Kickstart cannot be found the extraction check is reported as incomplete rather
# than failing the test.
#KICKSTART_PATH=~/Projects/akeeba/kickstart/output/kickstart_core.php


# =====================================================================================================================
# Remote storage (post-processing) integration tests (Test/Integration/Postproc/*)
# =====================================================================================================================
# Each remote storage provider has its own test that exercises the full upload / download / delete lifecycle against the
# live service for both a small file (single-shot upload) and a large file (multipart upload), verifying that the stored
# size and the SHA-512 checksum of the round-tripped data match the local original. A provider's test runs only when ALL
# of its credentials below are non-empty; otherwise it self-skips. The tests create and then delete their own throw-away
# objects, leaving the bucket clean.

# --- Amazon S3 (live AWS) --------------------------------------------------------------------------------------------
# Set AWS_S3_ACCESS_KEY, AWS_S3_SECRET_KEY and AWS_S3_BUCKET to run Test/Integration/Postproc/Amazons3Test. The key must
# allow put/get/delete and multipart uploads on the bucket. Objects are stored under the `akeeba-engine-test` prefix and
# removed on teardown. The engine uses its default bucket-owner-full-control ACL, which AWS accepts even on buckets with
# ACLs disabled (Object Ownership = Bucket owner enforced). The large-file test exercises a genuine multipart upload.
## AWS access key ID
#AWS_S3_ACCESS_KEY=
## AWS secret access key
#AWS_S3_SECRET_KEY=
## Bucket name (objects go under the akeeba-engine-test prefix)
#AWS_S3_BUCKET=
## Bucket region (default us-east-1). MUST match the bucket — v4 signatures are region-scoped
#AWS_S3_REGION=us-east-1
## Signature method: v4 (default) or v2
#AWS_S3_SIGNATURE=v4

# --- Amazon S3 against Minio (Docker) --------------------------------------------------------------------------------
# Test/Integration/Postproc/Amazons3MinioTest tests the SAME Amazon S3 engine against a throw-away Minio server running
# in Docker, through a custom endpoint with path-style addressing — no cloud credentials required. It is OPT-IN: it
# self-skips unless MINIO_TEST is truthy AND Docker is installed and its daemon is running. The test starts the container
# on a random loopback port, creates the bucket via a PUT-bucket S3 request, runs the full multipart lifecycle, and
# force-removes the container afterwards.
## Master opt-in switch. Set to 1/true/yes/on to enable (Docker must also be available)
#MINIO_TEST=1
## Docker image to run (default minio/minio:latest)
#MINIO_IMAGE=minio/minio:latest
## Minio root access key (default minioadmin)
#MINIO_ROOT_USER=minioadmin
## Minio root secret key (default minioadmin)
#MINIO_ROOT_PASSWORD=minioadmin
## Bucket name to create and use (default akeeba-engine-test-bucket)
#MINIO_BUCKET=akeeba-engine-test-bucket

# --- BackBlaze B2 ----------------------------------------------------------------------------------------------------
# Set all three to run Test/Integration/Postproc/BackblazeTest. BACKBLAZE_ID / BACKBLAZE_KEY are an application key pair
# (Key ID and the application key secret); BACKBLAZE_BUCKET is the bucket name (not its ID). The key must be allowed to
# read, write and delete files in that bucket. Objects are stored under the `akeeba-engine-test` prefix.
## BackBlaze B2 Account ID
#BACKBLAZE_ID=
## BackBlaze B2 Application Key
#BACKBLAZE_KEY=
## BackBlaze B2 Bucket
#BACKBLAZE_BUCKET=

# --- BackBlaze B2, bucket-restricted key (regression test) -----------------------------------------------------------
# Set all three to run Test/Integration/Postproc/BackblazeRestrictedTest, the regression test for the v4 authorization
# bug where a least-privilege key could not resolve its bucket. This key is INTENTIONALLY different from the one above:
# it MUST be restricted to exactly one bucket (BACKBLAZE_RESTRICTED_BUCKET) and MUST NOT have the listBuckets capability,
# which is what forces the engine through getBucketId()'s fast path with no b2_list_buckets fallback. It still needs
# writeFiles, readFiles and deleteFiles so the upload/download/delete round-trip can complete. Create it in the B2
# console (Application Keys → Add a New Application Key → "Allow access to Bucket(s): <one bucket>", file read+write,
# and do NOT tick listBuckets). BACKBLAZE_RESTRICTED_BUCKET is that bucket's name (not its ID).
## BackBlaze B2 Account ID (Key ID) of the bucket-restricted key
#BACKBLAZE_RESTRICTED_ID=
## BackBlaze B2 Application Key secret of the bucket-restricted key
#BACKBLAZE_RESTRICTED_KEY=
## The single bucket the restricted key is locked to
#BACKBLAZE_RESTRICTED_BUCKET=

# --- BackBlaze B2, multi-bucket key (regression test) ------------------------------------------------------------------
# Set BACKBLAZE_MULTIBUCKET_TEST=1 to run Test/Integration/Postproc/BackblazeMultiBucketTest, the regression test for the
# v4 multi-bucket key bug where only the FIRST of a key's allowed buckets could be resolved.
#
# You cannot supply this key yourself: the B2 web console only offers "all buckets" or exactly ONE bucket, so a
# multi-bucket key can only be born through the b2_create_key API (v4 takes a plural `bucketIds` array). The test
# therefore MINTS ITS OWN, from your BACKBLAZE_ID / BACKBLAZE_KEY above — which must be a key with the writeKeys and
# deleteKeys capabilities — scoped to two buckets your account already has. It deletes the key again on teardown, and
# gives it a ten-minute lifetime so BackBlaze expires it anyway if the test run is killed. The key is held in memory
# only: never written to disk, never logged. No buckets are created or destroyed.
#
# Because it creates a real credential on a real account, it is opt-in and off by default. The test picks the two buckets
# itself (BACKBLAZE_BUCKET plus any other bucket in the account); set BUCKET1/BUCKET2 only to override that choice. The
# lifecycle always runs against BUCKET2 — the bucket that used to be unreachable. BUCKET1 would pass even with the bug.
## Opt in to minting a short-lived multi-bucket key (1, true, yes or on)
#BACKBLAZE_MULTIBUCKET_TEST=1
## OPTIONAL: pin the first bucket the minted key may access (default: BACKBLAZE_BUCKET)
#BACKBLAZE_MULTIBUCKET_BUCKET1=
## OPTIONAL: pin the second bucket — the one the test uploads to (default: any other bucket in the account)
#BACKBLAZE_MULTIBUCKET_BUCKET2=

# --- Box -------------------------------------------------------------------------------------------------------------
# Set all three to run Test/Integration/Postproc/BoxTest. Box uses OAuth2: the engine reads the access/refresh tokens
# from config, but the akeeba.com Download ID (used to relay token refresh, oauth2_type=akeeba) from the platform. Box
# access tokens are short-lived (~60 min) — provide a FRESH access token plus a valid refresh token. The token must
# allow read, write and delete. Objects are stored in the `akeeba-engine-test` folder at the account root.
## Box OAuth2 access token (short-lived)
#BOX_ACCESS_TOKEN=
## Box OAuth2 refresh token
#BOX_REFRESH_TOKEN=
## akeeba.com Download ID, used to relay OAuth2 token refresh through akeeba.com
#BOX_DLID=

# --- RackSpace CloudFiles --------------------------------------------------------------------------------------------
# Set all three to run Test/Integration/Postproc/CloudfilesTest. CLOUDFILES_USERNAME is the Cloud account login name;
# CLOUDFILES_APIKEY is the API key (Account Settings -> API Key), NOT the password. CLOUDFILES_CONTAINER is an EXISTING
# container name (the engine never creates it). The region and storage endpoint are auto-detected from the auth
# response, so no region variable is needed. Objects are stored under the `akeeba-engine-test` prefix.
## RackSpace Cloud account username
#CLOUDFILES_USERNAME=
## RackSpace Cloud API key (not the password)
#CLOUDFILES_APIKEY=
## Existing CloudFiles container name
#CLOUDFILES_CONTAINER=

# --- OVH Object Storage ----------------------------------------------------------------------------------------------
# Set all four to run Test/Integration/Postproc/OvhTest. OVH Object Storage is OpenStack Swift behind OVH's public
# Keystone v3 service: the connector hard-codes the auth endpoint (https://auth.cloud.ovh.net) and the "Default" domain,
# so only the project/user/password and the container URL are configurable. Create an OpenStack user in the OVH Public
# Cloud panel (Project Management -> Users & Roles) — that gives you the OpenStack username and password and the
# Project ID (a.k.a. tenant ID). OVH_CONTAINERURL is the FULL storage URL of an EXISTING container (the engine never
# creates the container, only objects inside it, under the `akeeba-engine-test` pseudo-folder), e.g.
# https://storage.gra.cloud.ovh.net/v1/AUTH_xxxxxxxxxxxxxxxx/my-container
## OVH OpenStack Project (tenant) ID
#OVH_PROJECTID=
## OVH OpenStack username
#OVH_USERNAME=
## OVH OpenStack password
#OVH_PASSWORD=
## Full storage URL of an existing container (account path + container name)
#OVH_CONTAINERURL=

# --- Dropbox ---------------------------------------------------------------------------------------------------------
# Set DROPBOX_DLID plus at least one of DROPBOX_ACCESS_TOKEN / DROPBOX_REFRESH_TOKEN to run
# Test/Integration/Postproc/Dropbox2Test. Access tokens are short-lived (~4 h); the refresh token (recommended) lets the
# akeeba.com relay mint fresh ones using the Download ID. The app needs the files read/write, metadata, sharing and
# account_info scopes. Objects are stored in the `akeeba-engine-test` folder.
## Dropbox OAuth2 access token (short-lived)
#DROPBOX_ACCESS_TOKEN=
## Dropbox OAuth2 refresh token (recommended; required for the token-refresh test)
#DROPBOX_REFRESH_TOKEN=
## akeeba.com Download ID, used to relay OAuth2 token refresh through akeeba.com
#DROPBOX_DLID=
## Optional: set to 1 to test against a Dropbox Business team-space root; defaults to the personal namespace
#DROPBOX_TEAM=

# --- Google Drive ----------------------------------------------------------------------------------------------------
# Set GOOGLEDRIVE_ACCESS_TOKEN, GOOGLEDRIVE_REFRESH_TOKEN and GOOGLEDRIVE_DLID to run
# Test/Integration/Postproc/GoogledriveTest. The access token is short-lived but the connector auto-refreshes via the
# refresh token relayed through akeeba.com using the Download ID, so a slightly stale access token is fine. The token
# needs the full `drive` scope. Objects are stored in the `akeeba-engine-test` folder.
## Google Drive OAuth2 access token
#GOOGLEDRIVE_ACCESS_TOKEN=
## Google Drive OAuth2 refresh token
#GOOGLEDRIVE_REFRESH_TOKEN=
## akeeba.com Download ID, used to relay OAuth2 token refresh through akeeba.com
#GOOGLEDRIVE_DLID=
## Optional: Shared (Team) Drive ID; leave empty to use your personal Drive
#GOOGLEDRIVE_TEAM_DRIVE=

# --- Google Storage (S3 interoperability) ----------------------------------------------------------------------------
# Set all three to run Test/Integration/Postproc/GooglestorageTest. This is the LEGACY Google Storage engine, which
# talks to Google Cloud Storage through its S3-compatible (HMAC) API — NOT the newer JSON/service-account engine. Create
# the HMAC keys in Cloud Console -> Cloud Storage -> Settings -> Interoperability -> Access keys -> Create a key.
# GOOGLESTORAGE_BUCKET is the bucket name (not a URL); the key principal must read/write/delete objects in it. Objects
# are stored under the `akeeba-engine-test` prefix.
## Google Storage HMAC interoperability Access key
#GOOGLESTORAGE_ACCESS_KEY=
## Google Storage HMAC interoperability Secret
#GOOGLESTORAGE_SECRET_KEY=
## Google Storage bucket name
#GOOGLESTORAGE_BUCKET=
## Optional: set to 0 to talk HTTP instead of HTTPS (debugging only)
#GOOGLESTORAGE_USESSL=

# --- OneDrive for Business -------------------------------------------------------------------------------------------
# Set ONEDRIVEBUSINESS_ACCESS_TOKEN, ONEDRIVEBUSINESS_REFRESH_TOKEN and ONEDRIVEBUSINESS_DLID to run
# Test/Integration/Postproc/OnedrivebusinessTest. OAuth2 (Microsoft Graph): the access token is short-lived but is
# auto-refreshed via the refresh token relayed through akeeba.com using the Download ID. Objects are stored under the
# `akeeba-engine-test` prefix. (OneDrive and OneDriveApp are deprecated legacy engines and are not tested.)
## Microsoft Graph OAuth2 access token
#ONEDRIVEBUSINESS_ACCESS_TOKEN=
## Microsoft Graph OAuth2 refresh token
#ONEDRIVEBUSINESS_REFRESH_TOKEN=
## akeeba.com Download ID, used to relay OAuth2 token refresh through akeeba.com
#ONEDRIVEBUSINESS_DLID=
## Optional: target Drive ID (OneDrive for Business or SharePoint library); empty selects the personal/default Drive
#ONEDRIVEBUSINESS_DRIVE=
## Optional: set to 1 to also run the (destructive) token-refresh test, which may rotate the refresh token
#ONEDRIVEBUSINESS_TEST_REFRESH=

# --- WebDAV (Docker) -------------------------------------------------------------------------------------------------
# Test/Integration/Postproc/WebdavTest tests the WebDAV engine against a throw-away WebDAV server (rclone serve webdav)
# running in Docker — no external account required. It is OPT-IN: it self-skips unless WEBDAV_TEST is truthy AND Docker
# is installed and its daemon is running. The test starts the container on a random loopback port, lets the engine
# create the remote directory (MKCOL), runs the full upload/download/delete lifecycle, and force-removes the container
# afterwards. The default rclone/rclone image is multi-arch, so it runs natively on Apple Silicon (no emulation).
## Master opt-in switch. Set to 1/true/yes/on to enable (Docker must also be available)
#WEBDAV_TEST=1
## Docker image to run (default rclone/rclone:latest). If overridden it must run `serve webdav` from the same CLI flags
#WEBDAV_IMAGE=rclone/rclone:latest
## WebDAV username the container is configured with (default akeeba)
#WEBDAV_USERNAME=akeeba
## WebDAV password the container is configured with (default test-password)
#WEBDAV_PASSWORD=test-password

# --- OpenStack Swift (Docker) ----------------------------------------------------------------------------------------
# Test/Integration/Postproc/SwiftTest tests the Swift engine against a throw-away OpenStack Keystone + Swift server
# running in Docker — no external account required. The default image bundles both services and supports Keystone
# Identity v2 AND v3, so the test exercises both of the connector's authentication paths from a single container; the
# upload/download/delete lifecycle runs over Keystone v3. It is OPT-IN: it self-skips unless SWIFT_TEST is truthy AND
# Docker is installed and its daemon is running. The test starts the container on random loopback ports, waits for
# Keystone, discovers the demo project ID, creates the container, runs the full lifecycle, and force-removes the
# container afterwards. The default image is amd64-only, so on Apple Silicon it runs under Docker's emulation (slower,
# but functional); if the container cannot start the whole suite skips with a clear reason.
## Master opt-in switch. Set to 1/true/yes/on to enable (Docker must also be available)
#SWIFT_TEST=1
## Docker image to run (default jeantil/openstack-keystone-swift:pike). An override must serve Keystone v2/v3 on 35357
## and Swift on 8080, and (for the catalog/getEndPoints test) ship /swift/bin/register-swift-endpoint.sh
#SWIFT_IMAGE=jeantil/openstack-keystone-swift:pike
## OpenStack username / password the image is seeded with (defaults demo / demo)
#SWIFT_USERNAME=demo
#SWIFT_PASSWORD=demo
## Project (tenant) name and Keystone domain the demo user belongs to (defaults test / Default)
#SWIFT_PROJECT=test
#SWIFT_DOMAIN=Default
## Container name the test creates and uses (default akeeba-engine-test)
#SWIFT_CONTAINER=akeeba-engine-test
## Swift reseller (account) prefix, used only if the Keystone catalog has no object-store endpoint (default KEY_)
#SWIFT_RESELLER_PREFIX=KEY_

# --- FTP, native and over cURL (Docker) ------------------------------------------------------------------------------
# Test/Integration/Postproc/FtpTest (native PHP ext/ftp) and FtpcurlTest (cURL) test the two FTP engines against a
# throw-away pure-ftpd server running in Docker — no external account required. The image is a minimal alpine:3.20 +
# pure-ftpd built on the fly from Test/_docker/pure-ftpd (multi-arch, so it runs natively on Apple Silicon). It is
# OPT-IN: both self-skip unless FTP_TEST is truthy AND Docker is installed and its daemon is running. FtpTest also skips
# without the PHP ftp extension; FtpcurlTest also skips without cURL FTP support. The test picks a free host control port
# in the 4000-4999 range, publishes the control and passive ports on 127.0.0.1, lets the engine create the remote
# sub-directory, runs the full upload/download/delete lifecycle, and force-removes the container afterwards.
## Master opt-in switch. Set to 1/true/yes/on to enable (Docker must also be available)
#FTP_TEST=1
## Docker image to run (default: built locally from Test/_docker/pure-ftpd). Override only with a compatible pure-ftpd
## image that honours PUBLICHOST/FTP_USER_NAME/FTP_USER_PASS/FTP_USER_HOME/FTP_PASSIVE_PORTS and publishes 30000-30009
#FTP_IMAGE=
## FTP username / password the container is configured with (defaults akeeba / test-password)
#FTP_USERNAME=akeeba
#FTP_PASSWORD=test-password

# --- SFTP, native and over cURL (Docker) -----------------------------------------------------------------------------
# Test/Integration/Postproc/SftpTest (native PHP ext/ssh2) and SftpcurlTest (cURL) test the two SFTP engines against a
# throw-away SFTP server running in Docker — no external account required. The image is the stock jmcombs/sftp:latest, a
# multi-architecture drop-in fork of atmoz/sftp (so it runs natively on Apple Silicon). It is OPT-IN: both self-skip
# unless SFTP_TEST is truthy AND Docker is installed and its daemon is running. SftpTest also skips without the PHP ssh2
# extension; SftpcurlTest also skips without cURL SFTP support. SFTP is a single TCP connection (no passive ports): the
# test picks a free host port in the 4000-4999 range, publishes the SSH port on 127.0.0.1, lets the engine create the
# remote directory inside the user-writable /upload area, runs the full upload/download/delete lifecycle, and
# force-removes the container afterwards.
## Master opt-in switch. Set to 1/true/yes/on to enable (Docker must also be available)
#SFTP_TEST=1
## Docker image to run (default: jmcombs/sftp:latest). Override only with a compatible image that takes a
## "<user>:<pass>:::<dir>" command argument and chroots the user with a writable <dir> sub-directory (e.g. atmoz/sftp,
## which is amd64-only and runs under emulation on Apple Silicon)
#SFTP_IMAGE=jmcombs/sftp:latest
## SFTP username / password the container is configured with (defaults akeeba / test-password)
#SFTP_USERNAME=akeeba
#SFTP_PASSWORD=test-password
